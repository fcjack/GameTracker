# Copy to .env before deploying:
#   cp .env.deploy.example .env

# --- Database (internal to Docker network) ---
POSTGRES_USER=gametracker
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=gametracker

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- App secrets (required) ---
SESSION_SECRET=change-me-to-a-random-32-char-secret
ENCRYPTION_KEY=change-me-to-32-bytes-hex-encoded-key

# Set to false to block sign-in and new account creation (default: true)
SIGN_IN_ENABLED=true

# --- Cloudflare Tunnel (required for external access) ---
# Create a tunnel in Cloudflare Zero Trust and paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Traefik integration ---
# Docker network name shared with your Traefik instance (app joins it for routing).
TRAEFIK_NETWORK=traefik

# --- External APIs (optional) ---
STEAM_API_KEY=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
IGDB_BASE_URL=https://api.igdb.com/v4

# Optional: override the CI-published image
# APP_IMAGE=docker.io/jackcoelho/game-tracker:latest
