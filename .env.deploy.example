# Copy to .env before deploying:
#   cp .env.deploy.example .env

# --- Database (internal to Docker network) ---
POSTGRES_USER=gametracker
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=gametracker

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- App secrets (required) ---
SESSION_SECRET=change-me-to-a-random-32-char-secret
ENCRYPTION_KEY=change-me-to-32-bytes-hex-encoded-key

# --- Public site ---
# Hostname for HTTPS (e.g. tracker.example.com). Use ":80" for HTTP-only.
APP_DOMAIN=tracker.example.com
ACME_EMAIL=you@example.com

# Optional: override published ports if 80/443 are already in use
# HTTP_PORT=80
# HTTPS_PORT=443

# --- External APIs (optional) ---
STEAM_API_KEY=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
IGDB_BASE_URL=https://api.igdb.com/v4

# Optional: override the CI-published image
# APP_IMAGE=docker.io/jackcoelho/game-tracker:latest
