DATABASE_URL=postgres://gametracker:gametracker@localhost:5432/gametracker
# Steam Web API key (https://steamcommunity.com/dev/apikey) — required for Steam library import
STEAM_API_KEY=
# Microsoft OAuth app for Xbox linking and library import (see README)
# Register an app in Azure Portal → App registrations (personal Microsoft accounts / consumers).
# Redirect URI: http://localhost:8080/auth/xbox/callback (or your public URL + /auth/xbox/callback)
# Scopes requested by the app: xboxlive.signin, xboxlive.offline_access
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
APP_PORT=8080
# LOG_LEVEL=debug|info|warn|error (default: info)
LOG_LEVEL=info
# LOG_FORMAT=json|text (default: text)
LOG_FORMAT=text
SESSION_SECRET=change-me-to-a-random-32-char-secret
ENCRYPTION_KEY=change-me-to-32-bytes-hex-encoded-key
# Set to false to block new account registration; existing users can still sign in (default: true)
SIGN_IN_ENABLED=true
# Enable a background scheduler that periodically re-syncs every linked library (default: false)
LIBRARY_SYNC_ENABLED=false
# How often the scheduled sync runs (Go duration, e.g. 30m, 6h, 12h; default: 6h, minimum: 15m)
LIBRARY_SYNC_INTERVAL=6h
# Background workers that fetch/store playtime after library import (default: 3 workers, queue 256)
PLAYTIME_WORKER_COUNT=3
PLAYTIME_QUEUE_SIZE=256
# Retries and rate limit for Xbox User Stats API (default: 3 retries, 8 req/s)
PLAYTIME_RETRY_MAX=3
PLAYTIME_RATE_PER_SECOND=8
TWITCH_CLIENT_ID=test
TWITCH_CLIENT_SECRET=test
# IGDB API credentials (https://api-docs.igdb.com/) — used for dashboard search and import metadata