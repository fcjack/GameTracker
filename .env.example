DATABASE_URL=postgres://gametracker:gametracker@localhost:5432/gametracker
STEAM_API_KEY=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
APP_PORT=8080
# LOG_LEVEL=debug|info|warn|error (default: info)
LOG_LEVEL=info
# LOG_FORMAT=json|text (default: text)
LOG_FORMAT=text
SESSION_SECRET=change-me-to-a-random-32-char-secret
ENCRYPTION_KEY=change-me-to-32-bytes-hex-encoded-key
# Set to false to block new account registration; existing users can still sign in (default: true)
SIGN_IN_ENABLED=true
# Enable a background scheduler that periodically re-syncs every linked library (default: false)
LIBRARY_SYNC_ENABLED=false
# How often the scheduled sync runs (Go duration, e.g. 30m, 6h, 12h; default: 6h, minimum: 15m)
LIBRARY_SYNC_INTERVAL=6h
TWITCH_CLIENT_ID=test
TWITCH_CLIENT_SECRET=test